                            -- TARJETA | RECARGA | ) Tj T* (      RECARGA_EN_LINEA) Tj T* (  referencia     VARCHAR\(64\) UNIQUE                                 -- idempotencia: evita cobros ) Tj T* (      duplicados) Tj T* (\);) Tj T*  T* (CREATE TABLE alerta \() Tj T* (  id_alerta   SERIAL PRIMARY KEY,) Tj T* (  tipo        VARCHAR\(30\) NOT NULL,                                 -- SOBRECUPO | ESPERA_EXTRA) Tj T* (  id_estacion INT REFERENCES estacion\(id_estacion\),) Tj T* (  id_bus      INT REFERENCES bus\(id_bus\),) Tj T* (  fecha_hora  TIMESTAMPTZ NOT NULL DEFAULT NOW\(\),) Tj T* (  descripcion VARCHAR\(255\),) Tj T* (  atendida    BOOLEAN NOT NULL DEFAULT FALSE) Tj T* (\);) Tj T*  T* (CREATE TABLE incidente_seguridad \() Tj T* (  id_incidente SERIAL PRIMARY KEY,) Tj T* (  id_estacion  INT REFERENCES estacion\(id_estacion\),) Tj T* (  id_acceso    INT REFERENCES acceso\(id_acceso\),) Tj T* (  id_bus       INT REFERENCES bus\(id_bus\),) Tj T* (  fecha_hora   TIMESTAMPTZ NOT NULL DEFAULT NOW\(\),) Tj T* (  tipo         VARCHAR\(50\) NOT NULL,) Tj T* (  descripcion  VARCHAR\(255\)) Tj T* (\);) Tj T*  T* (CREATE TABLE usuario \() Tj T* (  id_usuario       SERIAL PRIMARY KEY,) Tj T* (  nombre           VARCHAR\(100\) NOT NULL,) Tj T* (  email            VARCHAR\(120\) NOT NULL UNIQUE,) Tj T* (  password_hash    VARCHAR\(100\) NOT NULL,) Tj T* (  rol              VARCHAR\(20\) NOT NULL CHECK \(rol IN \('admin','municipal','operador','guardia',) Tj T* (      'pasajero'\)\),) Tj T* (  id_estacion      INT REFERENCES estacion\(id_estacion\),) Tj T* (  id_municipalidad INT REFERENCES municipalidad\(id_municipalidad\),) Tj T* ET
