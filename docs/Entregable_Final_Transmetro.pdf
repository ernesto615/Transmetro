%PreformattedPara
.121569 .137255 .2 rg
BT 1 0 0 1 0 590.6 Tm /F3 7.4 Tf 9.2 TL (-- =====================================================================) Tj T* (-- Reglas de negocio aplicadas EN la base de datos \(segunda l\355nea de defensa\).) Tj T* (-- La API ya las valida en services/, pero as\355 nadie puede salt\341rselas con un INSERT manual.) Tj T* (-- Ejecutar DESPU\311S de 01_esquema.sql y ANTES de cargar datos.) Tj T* (-- =====================================================================) Tj T*  T* (-- Regla: una l\355nea admite entre N y 2N buses, siendo N su n\372mero de estaciones.) Tj T*  T* (-- \(a\) Al asignar un bus a una l\355nea: no superar el m\341ximo \(2N\)) Tj T* (CREATE OR REPLACE FUNCTION fn_bus_validar_linea\(\) RETURNS trigger AS $$) Tj T* (DECLARE n INT; actuales INT;) Tj T* (BEGIN) Tj T* (  IF NEW.id_linea IS NULL THEN RETURN NEW; END IF;) Tj T* (  IF TG_OP = 'UPDATE' THEN) Tj T* (    IF NEW.id_linea IS NOT DISTINCT FROM OLD.id_linea THEN RETURN NEW; END IF;) Tj T* (  END IF;) Tj T* (  SELECT COUNT\(*\) INTO n FROM linea_estacion WHERE id_linea = NEW.id_linea;) Tj T* (  IF n = 0 THEN) Tj T* (    RAISE EXCEPTION 'La l\355nea % no tiene estaciones; defina su recorrido antes de asignarle buses', NEW.) Tj T* (      id_linea;) Tj T* (  END IF;) Tj T* (  SELECT COUNT\(*\) INTO actuales FROM bus WHERE id_linea = NEW.id_linea AND id_bus <> COALESCE\(NEW.id_bus, ) Tj T* (      -1\);) Tj T* (  IF actuales + 1 > n * 2 THEN) Tj T* (    RAISE EXCEPTION 'La l\355nea % ya tiene el m\341ximo de buses permitido \(% = 2 x % estaciones\)', NEW.) Tj T* (      id_linea, n * 2, n;) Tj T* (  END IF;) Tj T* (  RETURN NEW;) Tj T* (END $$ LANGUAGE plpgsql;) Tj T*  T* (DROP TRIGGER IF EXISTS trg_bus_validar_linea ON bus;) Tj T* (CREATE TRIGGER trg_bus_validar_linea BEFORE INSERT OR UPDATE OF id_linea ON bus) Tj T* (  FOR EACH ROW EXECUTE FUNCTION fn_bus_validar_linea\(\);) Tj T*  T* (-- \(b\) Al sacar un bus de una l\355nea \(cambio de l\355nea o borrado\): no bajar del m\355nimo \(N\)) Tj T* (CREATE OR REPLACE FUNCTION fn_validar_salida_linea\(p_linea INT\) RETURNS void AS $$) Tj T* (DECLARE n INT; actuales INT;) Tj T* (BEGIN) Tj T* (  IF p_linea IS NULL THEN RETURN; END IF;) Tj T* (  SELECT COUNT\(*\) INTO n FROM linea_estacion WHERE id_linea = p_linea;) Tj T* (  SELECT COUNT\(*\) INTO actuales FROM bus WHERE id_linea = p_linea;) Tj T* (  IF n > 0 AND actuales = n THEN) Tj T* (    RAISE EXCEPTION 'La l\355nea % quedar\355a con menos buses que estaciones \(m\355nimo %\)', p_linea, n;) Tj T* (  END IF;) Tj T* (END $$ LANGUAGE plpgsql;) Tj T*  T* (CREATE OR REPLACE FUNCTION fn_bus_salida_update\(\) RETURNS trigger AS $$) Tj T* (BEGIN) Tj T* (  IF OLD.id_linea IS NOT NULL AND NEW.id_linea IS DISTINCT FROM OLD.id_linea THEN) Tj T* (    PERFORM fn_validar_salida_linea\(OLD.id_linea\);) Tj T* (  END IF;) Tj T* (  RETURN NEW;) Tj T* (END $$ LANGUAGE plpgsql;) Tj T*  T* (CREATE OR REPLACE FUNCTION fn_bus_salida_delete\(\) RETURNS trigger AS $$) Tj T* (BEGIN) Tj T* (  PERFORM fn_validar_salida_linea\(OLD.id_linea\);) Tj T* (  RETURN OLD;) Tj T* (END $$ LANGUAGE plpgsql;) Tj T*  T* (DROP TRIGGER IF EXISTS trg_bus_salida_update ON bus;) Tj T* (CREATE TRIGGER trg_bus_salida_update BEFORE UPDATE OF id_linea ON bus) Tj T* (  FOR EACH ROW EXECUTE FUNCTION fn_bus_salida_update\(\);) Tj T* (DROP TRIGGER IF EXISTS trg_bus_salida_delete ON bus;) Tj T* (CREATE TRIGGER trg_bus_salida_delete BEFORE DELETE ON bus) Tj T* ET
Q
 

Q

endstream
endobj
