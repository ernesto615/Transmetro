q
1 0 0 1 68.3622 76.10709 cm
%PreformattedPara
.121569 .137255 .2 rg
BT 1 0 0 1 0 581.4 Tm /F3 7.4 Tf 9.2 TL (-- =====================================================================) Tj T* (-- Consultas de los reportes \(constancia de los queries para el documento\).) Tj T* (-- Cada una corresponde a un endpoint de la API y a una pantalla de la web.) Tj T* (-- =====================================================================) Tj T*  T* (-- Q1 \267 Reporte de estaciones            \(GET /api/reportes/estaciones \267 pantalla Reportes\)) Tj T* (CREATE OR REPLACE VIEW v_reporte_estaciones AS) Tj T* (SELECT e.id_estacion,) Tj T* (       e.nombre                                         AS estacion,) Tj T* (       m.nombre                                         AS municipalidad,) Tj T* (       \(SELECT STRING_AGG\(l.nombre, ', ' ORDER BY l.nombre\)) Tj T* (          FROM linea_estacion le JOIN linea l ON l.id_linea = le.id_linea) Tj T* (         WHERE le.id_estacion = e.id_estacion\)          AS lineas,) Tj T* (       \(SELECT COUNT\(*\) FROM acceso a WHERE a.id_estacion = e.id_estacion\) AS accesos,) Tj T* (       \(SELECT COUNT\(*\) FROM guardia g JOIN acceso a ON a.id_acceso = g.id_acceso) Tj T* (         WHERE a.id_estacion = e.id_estacion\)           AS guardias,) Tj T* (       \(SELECT COUNT\(*\) FROM parqueo p WHERE p.id_estacion = e.id_estacion\) AS parqueos,) Tj T* (       -- cumple si tiene accesos y ninguno est\341 sin guardia) Tj T* (       \(EXISTS \(SELECT 1 FROM acceso a WHERE a.id_estacion = e.id_estacion\)) Tj T* (        AND NOT EXISTS \(SELECT 1 FROM acceso a) Tj T* (                         WHERE a.id_estacion = e.id_estacion) Tj T* (                           AND NOT EXISTS \(SELECT 1 FROM guardia g WHERE g.id_acceso = a.id_acceso\)\)\) AS ) Tj T* (      cumple_guardia_minima) Tj T* (FROM estacion e) Tj T* (JOIN municipalidad m ON m.id_municipalidad = e.id_municipalidad;) Tj T*  T* (SELECT * FROM v_reporte_estaciones ORDER BY estacion;) Tj T*  T* (-- Q2 \267 L\355neas con buses asignados y verificaci\363n del rango N..2N   \(GET /api/reportes/lineas-buses\)) Tj T* (CREATE OR REPLACE VIEW v_reporte_lineas_buses AS) Tj T* (WITH n AS \(SELECT id_linea, COUNT\(*\) AS estaciones FROM linea_estacion GROUP BY id_linea\),) Tj T* (     b AS \(SELECT id_linea, COUNT\(*\) AS buses FROM bus WHERE id_linea IS NOT NULL GROUP BY id_linea\)) Tj T* (SELECT l.id_linea,) Tj T* (       l.nombre                         AS linea,) Tj T* (       m.nombre                         AS municipalidad,) Tj T* (       l.distancia_total_km,) Tj T* (       COALESCE\(n.estaciones, 0\)        AS estaciones,) Tj T* (       COALESCE\(b.buses, 0\)             AS buses_asignados,) Tj T* (       COALESCE\(n.estaciones, 0\) || ' - ' || COALESCE\(n.estaciones, 0\) * 2 AS rango_permitido,) Tj T* (       COALESCE\(n.estaciones, 0\) > 0) Tj T* (         AND COALESCE\(b.buses, 0\) BETWEEN COALESCE\(n.estaciones, 0\) AND COALESCE\(n.estaciones, 0\) * 2 AS ) Tj T* (      cumple_rango) Tj T* (FROM linea l) Tj T* (JOIN municipalidad m ON m.id_municipalidad = l.id_municipalidad) Tj T* (LEFT JOIN n ON n.id_linea = l.id_linea) Tj T* (LEFT JOIN b ON b.id_linea = l.id_linea;) Tj T*  T* (SELECT * FROM v_reporte_lineas_buses ORDER BY linea;) Tj T*  T* (-- Q3 \267 Todos los accesos de cada l\355nea  \(GET /api/reportes/accesos-por-linea\)) Tj T* (SELECT l.nombre AS linea, le.orden, e.nombre AS estacion, a.nombre AS acceso) Tj T* (FROM linea l) Tj T* (JOIN linea_estacion le ON le.id_linea = l.id_linea) Tj T* (JOIN estacion e        ON e.id_estacion = le.id_estacion) Tj T* (JOIN acceso a          ON a.id_estacion = e.id_estacion) Tj T* (ORDER BY l.nombre, le.orden, a.nombre;) Tj T*  T* (-- Q4 \267 Detalle de buses de una l\355nea, con parqueo y piloto) Tj T* (SELECT b.placa, b.capacidad_maxima, p.nombre AS parqueo, pi.nombre AS piloto) Tj T* (FROM bus b) Tj T* (JOIN parqueo p     ON p.id_parqueo = b.id_parqueo) Tj T* (LEFT JOIN piloto pi ON pi.id_bus = b.id_bus) Tj T* (WHERE b.id_linea = \(SELECT id_linea FROM linea WHERE nombre = 'L\355nea 1 Centro-Norte'\)) Tj T* (ORDER BY b.placa;) Tj T* ET
Q
q
1 0 0 1 68.3622 66.90709 cm
