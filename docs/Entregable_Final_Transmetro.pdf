BT 1 0 0 1 0 204.2 Tm /F3 7.4 Tf 9.2 TL (  FOR EACH ROW EXECUTE FUNCTION fn_bus_salida_delete\(\);) Tj T*  T* (-- Regla: la distancia total de la l\355nea es la suma de los tramos entre estaciones.) Tj T* (CREATE OR REPLACE FUNCTION fn_actualizar_distancia_linea\(\) RETURNS trigger AS $$) Tj T* (DECLARE l INT;) Tj T* (BEGIN) Tj T* (  IF TG_OP = 'DELETE' THEN l := OLD.id_linea; ELSE l := NEW.id_linea; END IF;) Tj T* (  UPDATE linea) Tj T* (     SET distancia_total_km = \(SELECT COALESCE\(SUM\(distancia_a_siguiente_km\), 0\) FROM linea_estacion ) Tj T* (      WHERE id_linea = l\)) Tj T* (   WHERE id_linea = l;) Tj T* (  RETURN NULL;) Tj T* (END $$ LANGUAGE plpgsql;) Tj T*  T* (DROP TRIGGER IF EXISTS trg_distancia_linea ON linea_estacion;) Tj T* (CREATE TRIGGER trg_distancia_linea AFTER INSERT OR UPDATE OR DELETE ON linea_estacion) Tj T* (  FOR EACH ROW EXECUTE FUNCTION fn_actualizar_distancia_linea\(\);) Tj T*  T* (-- Reglas que ya cubre el propio esquema \(01_esquema.sql\):) Tj T* (--   * bus.id_parqueo NOT NULL            -> un bus nunca queda sin parqueo) Tj T* (--   * bus.id_linea es una sola columna   -> un bus pertenece a una sola l\355nea) Tj T* (--   * tarjeta_acceso.saldo CHECK >= 0    -> no hay saldo negativo) Tj T* (--   * transaccion.referencia UNIQUE      -> un reintento no cobra dos veces) Tj T* ET
Q
 

Q

