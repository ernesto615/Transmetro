q
1 0 0 1 68.3622 66.90709 cm
%PreformattedPara
.121569 .137255 .2 rg
BT 1 0 0 1 0 590.6 Tm /F3 7.4 Tf 9.2 TL (-- =====================================================================) Tj T* (-- TRANSMETRO \267 Esquema PostgreSQL \(equivale al que genera Sequelize\)) Tj T* (-- Orden de ejecuci\363n: 01_esquema -> 02_reglas_triggers -> 03_datos_demo) Tj T* (-- ATENCI\323N: los DROP borran todo. \332selo solo en la base de desarrollo.) Tj T* (-- =====================================================================) Tj T* (DROP TABLE IF EXISTS movimiento_financiero, horario_estacion, horario_linea, sugerencia, auditoria_bus, ) Tj T* (      usuario, incidente_seguridad, alerta, transaccion, tarjeta_acceso,) Tj T* (  piloto, bus, parqueo, operador, guardia, acceso, linea_estacion, estacion, linea, municipalidad CASCADE;) Tj T*  T* (CREATE TABLE municipalidad \() Tj T* (  id_municipalidad SERIAL PRIMARY KEY,) Tj T* (  nombre           VARCHAR\(100\) NOT NULL UNIQUE) Tj T* (\);) Tj T*  T* (CREATE TABLE linea \() Tj T* (  id_linea           SERIAL PRIMARY KEY,) Tj T* (  nombre             VARCHAR\(100\) NOT NULL,) Tj T* (  distancia_total_km NUMERIC\(8,2\) NOT NULL DEFAULT 0,      -- la mantiene un trigger) Tj T* (  id_municipalidad   INT NOT NULL REFERENCES municipalidad\(id_municipalidad\)) Tj T* (\);) Tj T*  T* (CREATE TABLE estacion \() Tj T* (  id_estacion      SERIAL PRIMARY KEY,) Tj T* (  nombre           VARCHAR\(100\) NOT NULL,) Tj T* (  id_municipalidad INT NOT NULL REFERENCES municipalidad\(id_municipalidad\),) Tj T* (  latitud          NUMERIC\(9,6\),) Tj T* (  longitud         NUMERIC\(9,6\)) Tj T* (\);) Tj T*  T* (-- Tabla intermedia: una estaci\363n puede estar en varias l\355neas y el orden va en la relaci\363n) Tj T* (CREATE TABLE linea_estacion \() Tj T* (  id_linea                 INT NOT NULL REFERENCES linea\(id_linea\),) Tj T* (  id_estacion              INT NOT NULL REFERENCES estacion\(id_estacion\),) Tj T* (  orden                    INT NOT NULL CHECK \(orden > 0\),) Tj T* (  distancia_a_siguiente_km NUMERIC\(6,2\) NOT NULL DEFAULT 0 CHECK \(distancia_a_siguiente_km >= 0\),) Tj T* (  PRIMARY KEY \(id_linea, id_estacion\),) Tj T* (  UNIQUE \(id_linea, orden\)) Tj T* (\);) Tj T*  T* (CREATE TABLE acceso \() Tj T* (  id_acceso   SERIAL PRIMARY KEY,) Tj T* (  nombre      VARCHAR\(100\) NOT NULL,) Tj T* (  id_estacion INT NOT NULL REFERENCES estacion\(id_estacion\)) Tj T* (\);) Tj T*  T* (CREATE TABLE guardia \() Tj T* (  id_guardia SERIAL PRIMARY KEY,) Tj T* (  nombre     VARCHAR\(100\) NOT NULL,) Tj T* (  turno      VARCHAR\(20\),) Tj T* (  id_acceso  INT NOT NULL REFERENCES acceso\(id_acceso\)) Tj T* (\);) Tj T*  T* (CREATE TABLE operador \() Tj T* (  id_operador SERIAL PRIMARY KEY,) Tj T* (  nombre      VARCHAR\(100\) NOT NULL,) Tj T* (  usuario     VARCHAR\(50\) NOT NULL UNIQUE,) Tj T* (  id_estacion INT NOT NULL REFERENCES estacion\(id_estacion\)) Tj T* (\);) Tj T*  T* (CREATE TABLE parqueo \() Tj T* (  id_parqueo  SERIAL PRIMARY KEY,) Tj T* (  nombre      VARCHAR\(100\) NOT NULL,) Tj T* (  capacidad   INT CHECK \(capacidad >= 0\),) Tj T* (  id_estacion INT REFERENCES estacion\(id_estacion\)         -- "algunas estaciones tienen parqueo") Tj T* (\);) Tj T* ET
Q
 

Q

endstream
