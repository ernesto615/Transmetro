linea\(id_linea\),) Tj T* (  id_estacion   INT REFERENCES estacion\(id_estacion\),) Tj T* (  mensaje       TEXT NOT NULL,) Tj T* (  fecha_hora    TIMESTAMPTZ NOT NULL DEFAULT NOW\(\),) Tj T* (  estado        VARCHAR\(20\) NOT NULL DEFAULT 'NUEVA' CHECK \(estado IN \('NUEVA','EN_REVISION','RESUELTA'\)\),) Tj T* (  nota_interna  VARCHAR\(500\)) Tj T* (\);) Tj T*  T* (-- Horarios editables por el administrador; sin fila = sin servicio ese d\355a) Tj T* (CREATE TABLE horario_linea \() Tj T* (  id_linea    INT NOT NULL REFERENCES linea\(id_linea\) ON DELETE CASCADE,) Tj T* (  tipo_dia    VARCHAR\(20\) NOT NULL CHECK \(tipo_dia IN \('LUNES_VIERNES','SABADO','DOMINGO_FESTIVOS'\)\),) Tj T* (  hora_inicio VARCHAR\(5\) NOT NULL,) Tj T* (  hora_fin    VARCHAR\(5\) NOT NULL,) Tj T* (  PRIMARY KEY \(id_linea, tipo_dia\),) Tj T* (  CHECK \(hora_inicio < hora_fin\)) Tj T* (\);) Tj T* (CREATE TABLE horario_estacion \() Tj T* (  id_estacion INT NOT NULL REFERENCES estacion\(id_estacion\) ON DELETE CASCADE,) Tj T* (  tipo_dia    VARCHAR\(20\) NOT NULL CHECK \(tipo_dia IN \('LUNES_VIERNES','SABADO','DOMINGO_FESTIVOS'\)\),) Tj T* (  hora_inicio VARCHAR\(5\) NOT NULL,) Tj T* (  hora_fin    VARCHAR\(5\) NOT NULL,) Tj T* (  PRIMARY KEY \(id_estacion, tipo_dia\),) Tj T* (  CHECK \(hora_inicio < hora_fin\)) Tj T* (\);) Tj T*  T* (CREATE INDEX idx_bus_linea     ON bus\(id_linea\);) Tj T* (CREATE INDEX idx_acceso_est    ON acceso\(id_estacion\);) Tj T* (CREATE INDEX idx_alerta_estado ON alerta\(atendida, fecha_hora DESC\);) Tj T* (CREATE INDEX idx_tx_fecha      ON transaccion\(fecha_hora DESC\);) Tj T* (CREATE INDEX idx_tx_linea      ON transaccion\(id_linea, fecha_hora\);) Tj T* ET
