BT 1 0 0 1 0 655 Tm /F3 7.4 Tf 9.2 TL (SELECT SUM\(le.distancia_a_siguiente_km\) AS km) Tj T* (FROM linea_estacion le) Tj T* (WHERE le.id_linea = \(SELECT id_linea FROM linea WHERE nombre = 'L\355nea 1 Centro-Norte'\)) Tj T* (  AND le.orden >= \(SELECT orden FROM linea_estacion WHERE id_linea = le.id_linea) Tj T* (                    AND id_estacion = \(SELECT id_estacion FROM estacion WHERE nombre = 'Centra Norte'\)\)) Tj T* (  AND le.orden <  \(SELECT orden FROM linea_estacion WHERE id_linea = le.id_linea) Tj T* (                    AND id_estacion = \(SELECT id_estacion FROM estacion WHERE nombre = 'Plaza Barrios'\)\);) Tj T*  T* (-- Q6 \267 Estaciones que pertenecen a m\341s de una l\355nea \(relaci\363n muchos a muchos\)) Tj T* (SELECT e.nombre AS estacion, COUNT\(*\) AS lineas) Tj T* (FROM linea_estacion le JOIN estacion e ON e.id_estacion = le.id_estacion) Tj T* (GROUP BY e.nombre HAVING COUNT\(*\) > 1;) Tj T*  T* (-- Q7 \267 Buses sin l\355nea asignada) Tj T* (SELECT placa, capacidad_maxima FROM bus WHERE id_linea IS NULL;) Tj T*  T* (-- Q8 \267 Recaudo por estaci\363n \(solo cobros de pasaje\)) Tj T* (SELECT e.nombre AS estacion, COUNT\(*\) AS cobros, SUM\(t.monto\) AS total) Tj T* (FROM transaccion t JOIN estacion e ON e.id_estacion = t.id_estacion) Tj T* (WHERE t.medio_pago = 'TARJETA') Tj T* (GROUP BY e.nombre ORDER BY total DESC;) Tj T*  T* (-- Q9 \267 Alertas abiertas por tipo \(tablero\)) Tj T* (SELECT tipo, COUNT\(*\) AS abiertas FROM alerta WHERE NOT atendida GROUP BY tipo;) Tj T*  T* (-- Q10 \267 Historial de cambios de asignaci\363n de un bus \(RNF-6\)) Tj T* (SELECT a.fecha_hora, a.id_linea_anterior, a.id_linea_nueva, a.id_parqueo_anterior, a.id_parqueo_nuevo) Tj T* (FROM auditoria_bus a JOIN bus b ON b.id_bus = a.id_bus) Tj T* (WHERE b.placa = 'TM-100' ORDER BY a.fecha_hora DESC;) Tj T*  T* (-- Q11 \267 \277D\363nde y cu\341ndo pag\363 o recarg\363 una tarjeta? \(GET /api/mi/tarjetas/:numero/historial\)) Tj T* (SELECT t.fecha_hora, t.medio_pago, t.monto, COALESCE\(e.nombre, 'En l\355nea'\) AS lugar) Tj T* (FROM transaccion t) Tj T* (JOIN tarjeta_acceso c ON c.id_tarjeta = t.id_tarjeta) Tj T* (LEFT JOIN estacion e  ON e.id_estacion = t.id_estacion) Tj T* (WHERE c.numero = 'TM-0001-2026') Tj T* (ORDER BY t.fecha_hora DESC;) Tj T*  T* (-- Q12 \267 \332ltimo uso \(pasaje\) de cada tarjeta, con su due\361o) Tj T* (SELECT c.numero, u.nombre AS pasajero, MAX\(t.fecha_hora\) AS ultimo_uso) Tj T* (FROM tarjeta_acceso c) Tj T* (LEFT JOIN usuario u ON u.id_usuario = c.id_usuario) Tj T* (LEFT JOIN transaccion t ON t.id_tarjeta = c.id_tarjeta AND t.medio_pago = 'TARJETA') Tj T* (GROUP BY c.numero, u.nombre;) Tj T*  T* (-- Q13 \267 Horarios de servicio por l\355nea \(se muestran en la pantalla principal\)) Tj T* (SELECT l.nombre AS linea,) Tj T* (       MAX\(CASE WHEN h.tipo_dia='LUNES_VIERNES'    THEN h.hora_inicio || ' a ' || h.hora_fin END\) AS ) Tj T* (      lunes_a_viernes,) Tj T* (       MAX\(CASE WHEN h.tipo_dia='SABADO'           THEN h.hora_inicio || ' a ' || h.hora_fin END\) AS ) Tj T* (      sabado,) Tj T* (       MAX\(CASE WHEN h.tipo_dia='DOMINGO_FESTIVOS' THEN h.hora_inicio || ' a ' || h.hora_fin END\) AS ) Tj T* (      domingo_y_festivos) Tj T* (FROM linea l LEFT JOIN horario_linea h ON h.id_linea = l.id_linea) Tj T* (GROUP BY l.nombre ORDER BY l.nombre;) Tj T*  T* (-- Q14 \267 Sugerencias y quejas pendientes) Tj T* (SELECT fecha_hora, tipo, estado, COALESCE\(nombre,'An\363nimo'\) AS de, LEFT\(mensaje, 80\) AS mensaje) Tj T* (FROM sugerencia WHERE estado <> 'RESUELTA' ORDER BY fecha_hora DESC;) Tj T*  T* (-- Q15 \267 Pasajeros con su documento registrado \(los n\372meros est\341n cifrados: solo se ve si existen\)) Tj T* (SELECT nombre, email, telefono, dpi_hash IS NOT NULL AS tiene_dpi, nit_hash IS NOT NULL AS tiene_nit) Tj T* (FROM usuario WHERE rol = 'pasajero';) Tj T*  T* (-- Q16 \267 Flujo de caja mensual: entradas \(recargas + otros ingresos\) menos salidas \(egresos\)) Tj T* (SELECT to_char\(m.mes, 'YYYY-MM'\) AS mes,) Tj T* (       COALESCE\(t.recargas, 0\) + COALESCE\(v.ingresos, 0\) AS entradas,) Tj T* (       COALESCE\(v.egresos, 0\) AS salidas,) Tj T* (       COALESCE\(t.recargas, 0\) + COALESCE\(v.ingresos, 0\) - COALESCE\(v.egresos, 0\) AS flujo_neto) Tj T* (FROM generate_series\(date_trunc\('month', now\(\)\) - interval '5 months', date_trunc\('month', now\(\)\), ) Tj T* (      interval '1 month'\) AS m\(mes\)) Tj T* (LEFT JOIN \(SELECT date_trunc\('month', fecha_hora\) AS mes, SUM\(monto\) AS recargas) Tj T* ET
Q
 

Q

endstream
endobj
