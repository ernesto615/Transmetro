BT 1 0 0 1 0 213.4 Tm /F3 7.4 Tf 9.2 TL (           FROM transaccion WHERE medio_pago LIKE 'RECARGA%' GROUP BY 1\) t ON t.mes = m.mes) Tj T* (LEFT JOIN \(SELECT date_trunc\('month', fecha::timestamp\) AS mes,) Tj T* (                  SUM\(monto\) FILTER \(WHERE tipo = 'INGRESO'\) AS ingresos, SUM\(monto\) FILTER \(WHERE tipo = ) Tj T* (      'EGRESO'\) AS egresos) Tj T* (           FROM movimiento_financiero GROUP BY 1\) v ON v.mes = m.mes) Tj T* (ORDER BY m.mes;) Tj T*  T* (-- Q17 \267 L\355nea m\341s usada: pasajes en los \372ltimos 30 d\355as y pasajes por bus por d\355a) Tj T* (SELECT l.nombre AS linea,) Tj T* (       COUNT\(t.id_transaccion\) AS pasajes,) Tj T* (       ROUND\(COUNT\(t.id_transaccion\) / 30.0, 1\) AS pasajes_por_dia,) Tj T* (       \(SELECT COUNT\(*\) FROM bus b WHERE b.id_linea = l.id_linea\) AS buses,) Tj T* (       ROUND\(COUNT\(t.id_transaccion\) / 30.0 / NULLIF\(\(SELECT COUNT\(*\) FROM bus b WHERE b.id_linea = l.) Tj T* (      id_linea\), 0\), 1\) AS pasajes_por_bus_dia) Tj T* (FROM linea l) Tj T* (LEFT JOIN transaccion t ON t.id_linea = l.id_linea AND t.medio_pago = 'TARJETA' AND t.fecha_hora >= now\(\) ) Tj T* (      - interval '30 days') Tj T* (GROUP BY l.id_linea, l.nombre ORDER BY pasajes DESC;) Tj T*  T* (-- Q18 \267 Alertas de sobrecupo por l\355nea en los \372ltimos 7 d\355as) Tj T* (SELECT l.nombre AS linea, COUNT\(*\) AS sobrecupos) Tj T* (FROM alerta a JOIN bus b ON b.id_bus = a.id_bus JOIN linea l ON l.id_linea = b.id_linea) Tj T* (WHERE a.tipo = 'SOBRECUPO' AND a.fecha_hora >= now\(\) - interval '7 days') Tj T* (GROUP BY l.nombre ORDER BY sobrecupos DESC;) Tj T* ET
Q
 

Q

endstream
endobj
